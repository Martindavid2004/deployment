# Docker ignore file for CodoAI Platform

# Git
.git
.gitignore

# Documentation
*.md
LICENSE

# Node modules
node_modules
npm-debug.log*

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# Environment files
.env
.env.local
.env.production

# IDE files
.vscode
.idea
*.swp
*.swo

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp
temp
.tmp
.temp

# Build artifacts
dist
build
.next
out

# Test coverage
coverage
.nyc_output

# Docker files (don't copy into themselves)
Dockerfile*
docker-compose*.yml