# CodoAI Platform Environment Configuration
# Copy this file to .env and update the values

# MongoDB Configuration
MONGO_USERNAME=admin
MONGO_PASSWORD=password123
MONGO_DB_NAME=codo-ai

# JWT Authentication
JWT_SECRET=supersecretchangeit-pleasechangethis
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini API (for AI features)
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# AWS Configuration (Optional - for Lambda execution)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_LAMBDA_FUNCTION_NAME=python-code-executor

# Development URLs (automatically configured in Docker)
# These are used for local development outside Docker
DEV_FRONTEND_URL=http://localhost:3000
DEV_BACKEND_URL=http://localhost:8000
DEV_JUDGE_URL=http://localhost:8888