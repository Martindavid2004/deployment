# CodoAI Platform Git Ignore

# Environment files (contains secrets)
.env
.env.local
.env.production

# Docker volumes and data
volumes/
data/
logs/
backups/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log

# Docker
.docker/

# MongoDB data (if running locally)
mongodb-data/

# Temp files
temp/
tmp/
*.tmp

# Coverage reports
htmlcov/
.coverage
.pytest_cache/

# Build artifacts
*.tgz
*.tar.gz

# Terraform files (State and plugins should never be in Git)
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
terraform.tfvars